# ─────────────────────────────────────────────────────────────
# Voltherm — example environment variables
# Copy this file to backend/.env and frontend/.env, then fill in
# real values. Nothing in this file is a real secret.
# ─────────────────────────────────────────────────────────────

# ===== backend/.env =====
PORT=4000
NODE_ENV=development

# FortyGuard Heat Intelligence API (https://fortyguard.example)
# Never call this from the frontend — only the backend should hold this key.
FORTYGUARD_API_KEY=fg_test_00000000000000000000000000000000
FORTYGUARD_BASE_URL=https://api.fortyguard.com/v1

# Anthropic API key, used by the agent pipeline (manager + sub-agents)
ANTHROPIC_API_KEY=sk-ant-00000000000000000000000000000000000000000000

# Site storage — SQLite file path (swap for a Supabase/Postgres URL in prod)
DATABASE_URL=file:./voltherm.sqlite

# CORS origin allowed to hit the API (the Vite dev server by default)
CORS_ORIGIN=http://localhost:5173

# ===== frontend/.env =====
VITE_API_BASE_URL=http://localhost:4000
