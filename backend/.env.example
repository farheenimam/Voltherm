PORT=4000

# FortyGuard — one key per employee agent (falls back to FORTYGUARD_API_KEY if unset)
FORTYGUARD_BASE_URL=https://api.fortyguard.com/v1
FORTYGUARD_API_KEY=
FORTYGUARD_API_KEY_HEAT=
FORTYGUARD_API_KEY_SHADE=
FORTYGUARD_API_KEY_FINANCIAL=

# Groq — used by both the manager's recommendation call and the critique agent
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Agent service used by backend (default local node agent)
AGENT_SERVICE_URL=http://localhost:5000
